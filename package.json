{
  "name": "@bizon/selling-partner-api-sdk",
  "private": true,
  "description": "Modularized, fully-typed TypeScript SDK for the Amazon Selling Partner API (SP-API), with independently versioned clients regenerated daily",
  "repository": "git@github.com:bizon/selling-partner-api-sdk.git",
  "author": "Bertrand Marron <bertrand@bizon.solutions>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:ts": "turbo run check:ts",
    "codegen": "tsx --tsconfig codegen/tsconfig.json codegen/generate.ts",
    "predocs": "turbo run build --filter=@sp-api-sdk/common",
    "test": "turbo run test",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@lerna-lite/cli": "^5.6.1",
    "@lerna-lite/publish": "^5.6.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/node": "^24.19.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint-config-xo-bizon": "^4.5.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "xo": "^4.0.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
